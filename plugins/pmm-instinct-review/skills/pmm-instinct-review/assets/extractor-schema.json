{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["correction", "confirmation", "voice", "scope", "workflow"]},
          "rule": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "maxLength": 160},
          "context": {"type": "string", "maxLength": 300}
        },
        "required": ["type", "rule", "evidence", "context"],
        "additionalProperties": false
      }
    }
  },
  "required": ["candidates"],
  "additionalProperties": false
}
