{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed governance pack manifest",
  "type": "object",
  "required": ["schema_version", "source", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "source": {"type": "string", "format": "uri"},
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "files"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "enforcement_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["instruction-only", "static-validator", "runtime-guard", "capability-boundary", "external-authority"]
            }
          },
          "activation": {
            "enum": ["installed", "installed-inactive", "enabled", "external-unverified"]
          }
        }
      }
    }
  }
}
