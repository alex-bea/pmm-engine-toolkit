{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential-isolated publisher adapter",
  "type": "object",
  "required": ["schema_version", "adapter_id", "enabled", "approved", "command", "allowed_operations", "timeout_seconds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "approved": {"type": "boolean"},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"type": "string", "pattern": "^/"}],
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}
  }
}
