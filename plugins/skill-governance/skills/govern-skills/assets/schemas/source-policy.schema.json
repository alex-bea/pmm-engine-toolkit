{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed workflow source policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "status", "approval_authority", "allowed_sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["template", "active", "deprecated"]},
    "approval_authority": {
      "type": "object",
      "required": ["authority_id", "verifier_config"],
      "additionalProperties": false,
      "properties": {
        "authority_id": {"type": "string", "minLength": 1},
        "verifier_config": {"type": "string", "pattern": "^/"}
      }
    },
    "allowed_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "adapter", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
