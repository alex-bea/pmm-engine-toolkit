{
  "description": "Optional repository-scoped governance guard. Inactive unless the current repository enables .agents/governance/enforcement.yaml.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/govern-skills/scripts/codex_pretooluse.py\"",
            "timeout": 5,
            "statusMessage": "Checking repository governance"
          }
        ]
      }
    ]
  }
}
