{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/comp-intel/synthesis-package.schema.json",
  "title": "Bounded synthesis handoff",
  "type": "object",
  "required": ["schema_version", "run_id", "market_id", "evidence_digest", "claims", "report", "proposed_change_set"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "market_id": {"type": "string"},
    "evidence_digest": {"type": "string"},
    "claims": {"type": "array"},
    "report": {
      "type": "object",
      "required": ["executive_signals", "coverage", "limitations", "material_changes", "implications", "open_questions", "next_actions", "selected_claim_ids", "public_safe"],
      "properties": {
        "executive_signals": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/claim_statement"}},
        "coverage": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "material_changes": {"type": "array", "items": {"$ref": "#/$defs/claim_statement"}},
        "implications": {"type": "array", "items": {"$ref": "#/$defs/claim_statement"}},
        "open_questions": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "items": {"$ref": "#/$defs/claim_statement"}},
        "selected_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "public_safe": {"type": "boolean"}
      }
    },
    "proposed_change_set": {"type": "object"}
  },
  "$defs": {
    "claim_statement": {
      "type": "object",
      "required": ["text", "claim_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
