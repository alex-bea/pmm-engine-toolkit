{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/comp-intel/config.schema.json",
  "title": "Competitive intelligence configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "markets", "reviewers", "output_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "default_market": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "markets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_reviewer", "apply_approver"],
      "properties": {
        "evidence_reviewer": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "apply_approver": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "output_policy": {
      "type": "object",
      "required": ["public_safe_default", "external_publication"],
      "properties": {
        "public_safe_default": {"type": "boolean"},
        "external_publication": {"const": false}
      }
    }
  }
}
