{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/comp-intel/market-pack.schema.json",
  "title": "Competitive intelligence market pack",
  "type": "object",
  "required": ["schema_version", "market_id", "display_name", "version", "competitors", "analysis", "window_policy", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "market_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "competitors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["competitor_id", "display_name", "status"],
        "properties": {
          "competitor_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "display_name": {"type": "string"},
          "status": {"enum": ["active", "monitor", "watchlist", "dormant"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "ambiguity_filters": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "analysis": {"type": "object"},
    "window_policy": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "adapter_id", "required", "enabled", "config"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "adapter_id": {"enum": ["synthetic", "local_files", "web", "github", "slack"]},
          "required": {"type": "boolean"},
          "enabled": {"type": "boolean"},
          "config": {"type": "object"}
        }
      }
    }
  }
}
